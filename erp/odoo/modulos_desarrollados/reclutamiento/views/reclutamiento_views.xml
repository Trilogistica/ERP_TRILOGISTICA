<odoo>
    <record id="view_reclutamiento_form" model="ir.ui.view">
        <field name="name">reclutamiento.form</field>
        <field name="model">reclutamiento.candidato</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="telefono"/>
                        <field name="fecha_aplicacion"/>
                        <field name="estado"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
