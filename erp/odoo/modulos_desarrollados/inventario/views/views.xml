<odoo>
    <record id="action_inventario" model="ir.actions.act_window">
        <field name="name">Inventario</field>
        <field name="res_model">inventario.inventario</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_servicios" model="ir.actions.act_window">
        <field name="name">Servicios</field>
        <field name="res_model">inventario.servicio</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_inventario_root" name="Inventario" sequence="10"/>
    <menuitem id="menu_inventario" name="Gestión de Inventario"
              parent="menu_inventario_root" action="action_inventario"/>
    <menuitem id="menu_servicios" name="Ver Servicios"
              parent="menu_inventario_root" action="action_servicios"/>

    <record id="view_inventario_list" model="ir.ui.view">
        <field name="name">inventario.list</field>
        <field name="model">inventario.inventario</field>
        <field name="arch" type="xml">
            <list string="Inventario de Servicios">
                <field name="name"/>
                <field name="proveedor_id"/>
            </list>
        </field>
    </record>

    <record id="view_inventario_form" model="ir.ui.view">
        <field name="name">inventario.form</field>
        <field name="model">inventario.inventario</field>
        <field name="arch" type="xml">
            <form string="Inventario de Servicios">
                <sheet>
                    <group>
                        <field name="name" placeholder="Número de inventario"/>
                        <field name="proveedor_id"/>
                    </group>
                    <notebook>
                        <page string="Servicios">
                            <field name="servicio_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="precio"/>
                                    <field name="fecha_compra"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <button name="%(action_servicios)d" type="action" string="Ver Servicios" class="oe_highlight"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_servicio_list" model="ir.ui.view">
        <field name="name">servicio.list</field>
        <field name="model">inventario.servicio</field>
        <field name="arch" type="xml">
            <list string="Servicios">
                <field name="name"/>
                <field name="precio"/>
                <field name="fecha_compra"/>
                <field name="inventario_id"/>
            </list>
        </field>
    </record>

    <record id="view_servicio_form" model="ir.ui.view">
        <field name="name">servicio.form</field>
        <field name="model">inventario.servicio</field>
        <field name="arch" type="xml">
            <form string="Servicios">
                <sheet>
                    <group>
                        <field name="name" placeholder="Nombre del servicio"/>
                        <field name="inventario_id"/>
                    </group>
                    <group>
                        <field name="precio"/>
                        <field name="fecha_compra"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
