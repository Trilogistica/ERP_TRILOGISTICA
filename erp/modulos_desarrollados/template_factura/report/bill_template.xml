<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<template id="bill_template">
        <t t-call="web.html_container">
          <t t-foreach="docs" t-as="doc">
              <t t-call= "web.external_layout">
              <div class= "page">
                <h1>Hellow</h1>
              </div>
              </t>
          </t>
        </t>
    </template>

<record id="bill_template_action" model="ir.actions.report">
  <field name="name">Factura Generada</field>
  <field name="model">gastos.gasto</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">template_factura.bill_template</field>
  <field name="report_file">template_factura.bill_template</field>
  <field name="print_report_name">'Factura-Generada'</field>
  <field name="binding_model_id" ref="gastos.model_gastos_gasto"/>
   <field name="binding_type">report</field>
</record>

</odoo>